package com.allrounder99.app;

import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.view.View;
import android.widget.ArrayAdapter;
import android.widget.Button;
import android.widget.EditText;
import android.widget.ListView;
import android.widget.Spinner;
import android.widget.TextView;
import android.widget.Toast;

import androidx.annotation.NonNull;
import androidx.appcompat.app.AlertDialog;
import androidx.appcompat.app.AppCompatActivity;

import com.google.firebase.database.DataSnapshot;
import com.google.firebase.database.DatabaseError;
import com.google.firebase.database.DatabaseReference;
import com.google.firebase.database.FirebaseDatabase;
import com.google.firebase.database.ValueEventListener;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

public class MainActivity extends AppCompatActivity {

    private EditText etPhoneNumber, etMessage;
    private Button btnSendTelegram, btnSendWhatsApp;
    private Spinner spinnerTeamMember;
    private ListView listViewPending, listViewCompleted;
    private TextView tvStatsKrish, tvStatsSunny, tvStatsAllrounder;

    private DatabaseReference pendingRef, completedRef, statsRef;
    private ArrayList<String> pendingList, completedList;
    private ArrayAdapter<String> pendingAdapter, completedAdapter;

    private final List<String> defaultNumbers = Arrays.asList(
        "6360533012", "6360991651", "9738680787", "9008905567", "9036926155",
        "6361586342", "6362419891", "6363560933", "6364422009", "6364446080"
    );

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        showLoginDialog();
    }

    private void showLoginDialog() {
        AlertDialog.Builder builder = new AlertDialog.Builder(this);
        builder.setTitle("Allrounder99 - Secure Login");
        builder.setCancelable(false);

        View view = getLayoutInflater().inflate(R.layout.dialog_login, null);
        EditText etUser = view.findViewById(R.id.etLoginUser);
        EditText etPass = view.findViewById(R.id.etLoginPass);
        Button btnLogin = view.findViewById(R.id.btnLoginSubmit);

        builder.setView(view);
        AlertDialog dialog = builder.create();

        btnLogin.setOnClickListener(v -> {
            String username = etUser.getText().toString().trim();
            String password = etPass.getText().toString().trim();

            if (username.equals("admin99") && password.equals("allrounder@2026")) {
                dialog.dismiss();
                initAppUI();
            } else {
                Toast.makeText(this, "Invalid ID or Password!", Toast.LENGTH_SHORT).show();
            }
        });

        dialog.show();
    }

    private void initAppUI() {
        setContentView(R.layout.activity_main);

        etPhoneNumber = findViewById(R.id.etPhoneNumber);
        etMessage = findViewById(R.id.etMessage);
        btnSendTelegram = findViewById(R.id.btnSendTelegram);
        btnSendWhatsApp = findViewById(R.id.btnSendWhatsApp);
        spinnerTeamMember = findViewById(R.id.spinnerTeamMember);
        listViewPending = findViewById(R.id.listViewPending);
        listViewCompleted = findViewById(R.id.listViewCompleted);

        tvStatsKrish = findViewById(R.id.tvStatsKrish);
        tvStatsSunny = findViewById(R.id.tvStatsSunny);
        tvStatsAllrounder = findViewById(R.id.tvStatsAllrounder);

        String[] members = {"Select Member", "KRISH", "SUNNY", "ALLROUNDER99"};
        ArrayAdapter<String> spinnerAdapter = new ArrayAdapter<>(this, android.R.layout.simple_spinner_dropdown_item, members);
        spinnerTeamMember.setAdapter(spinnerAdapter);

        pendingRef = FirebaseDatabase.getInstance().getReference("Pending_Customers");
        completedRef = FirebaseDatabase.getInstance().getReference("Completed_Messages");
        statsRef = FirebaseDatabase.getInstance().getReference("Team_Stats");

        pendingList = new ArrayList<>();
        completedList = new ArrayList<>();

        pendingAdapter = new ArrayAdapter<>(this, android.R.layout.simple_list_item_1, pendingList);
        completedAdapter = new ArrayAdapter<>(this, android.R.layout.simple_list_item_1, completedList);

        listViewPending.setAdapter(pendingAdapter);
        listViewCompleted.setAdapter(completedAdapter);

        initializeDefaultDataInFirebase();
        fetchRealtimeData();

        btnSendTelegram.setOnClickListener(v -> processMessageSending("Telegram"));
        btnSendWhatsApp.setOnClickListener(v -> processMessageSending("WhatsApp"));

        listViewPending.setOnItemClickListener((parent, view, position, id) -> {
            String selectedNum = pendingList.get(position);
            etPhoneNumber.setText(selectedNum);
        });
    }

    private void initializeDefaultDataInFirebase() {
        pendingRef.addListenerForSingleValueEvent(new ValueEventListener() {
            @Override
            public void onDataChange(@NonNull DataSnapshot snapshot) {
                if (!snapshot.exists()) {
                    for (String num : defaultNumbers) {
                        pendingRef.push().setValue(num);
                    }
                }
            }
            @Override
            public void onCancelled(@NonNull DatabaseError error) {}
        });
    }

    private void processMessageSending(String platform) {
        String phone = etPhoneNumber.getText().toString().trim();
        String message = etMessage.getText().toString().trim();
        String selectedMember = spinnerTeamMember.getSelectedItem().toString();

        if (selectedMember.equals("Select Member")) {
            Toast.makeText(this, "Please select team member name first!", Toast.LENGTH_SHORT).show();
            return;
        }

        if (!phone.isEmpty() && !message.isEmpty()) {
            if (platform.equals("Telegram")) {
                boolean sent = sendViaTelegram(phone, message);
                if (!sent) {
                    sendViaWhatsApp(phone, message);
                    platform = "WhatsApp (Fallback)";
                }
            } else {
                sendViaWhatsApp(phone, message);
            }

            saveToCompletedFolder(phone, selectedMember, platform);
            clearFields();
        } else {
            Toast.makeText(this, "Enter phone and message text", Toast.LENGTH_SHORT).show();
        }
    }

    private boolean sendViaTelegram(String phone, String message) {
        try {
            Intent intent = new Intent(Intent.ACTION_VIEW);
            intent.setData(Uri.parse("https://t.me/" + phone + "?text=" + Uri.encode(message)));
            startActivity(intent);
            return true;
        } catch (Exception e) {
            return false;
        }
    }

    private void sendViaWhatsApp(String phone, String message) {
        try {
            Intent intent = new Intent(Intent.ACTION_VIEW);
            intent.setData(Uri.parse("https://api.whatsapp.com/send?phone=" + phone + "&text=" + Uri.encode(message)));
            startActivity(intent);
        } catch (Exception e) {
            Toast.makeText(this, "WhatsApp not installed", Toast.LENGTH_SHORT).show();
        }
    }

    private void saveToCompletedFolder(String phone, String memberName, String platform) {
        String recordString = "No: " + phone + " | By: " + memberName + " | Via: " + platform;
        completedRef.push().setValue(recordString);

        pendingRef.orderByValue().equalTo(phone).addListenerForSingleValueEvent(new ValueEventListener() {
            @Override
            public void onDataChange(@NonNull DataSnapshot snapshot) {
                for (DataSnapshot child : snapshot.getChildren()) {
                    child.getRef().removeValue();
                }
            }
            @Override
            public void onCancelled(@NonNull DatabaseError error) {}
        });

        statsRef.child(memberName).addListenerForSingleValueEvent(new ValueEventListener() {
            @Override
            public void onDataChange(@NonNull DataSnapshot snapshot) {
                int currentCount = snapshot.exists() ? snapshot.getValue(Integer.class) : 0;
                statsRef.child(memberName).setValue(currentCount + 1);
            }
            @Override
            public void onCancelled(@NonNull DatabaseError error) {}
        });

        Toast.makeText(this, "Marked Done by " + memberName, Toast.LENGTH_SHORT).show();
    }

    private void fetchRealtimeData() {
        pendingRef.addValueEventListener(new ValueEventListener() {
            @Override
            public void onDataChange(@NonNull DataSnapshot snapshot) {
                pendingList.clear();
                for (DataSnapshot data : snapshot.getChildren()) {
                    String val = data.getValue(String.class);
                    if (val != null) pendingList.add(val);
                }
                pendingAdapter.notifyDataSetChanged();
            }
            @Override
            public void onCancelled(@NonNull DatabaseError error) {}
        });

        completedRef.addValueEventListener(new ValueEventListener() {
            @Override
            public void onDataChange(@NonNull DataSnapshot snapshot) {
                completedList.clear();
                for (DataSnapshot data : snapshot.getChildren()) {
                    String val = data.getValue(String.class);
                    if (val != null) completedList.add(val);
                }
                completedAdapter.notifyDataSetChanged();
            }
            @Override
            public void onCancelled(@NonNull DatabaseError error) {}
        });

        statsRef.addValueEventListener(new ValueEventListener() {
            @Override
            public void onDataChange(@NonNull DataSnapshot snapshot) {
                int kCount = snapshot.child("KRISH").exists() ? snapshot.child("KRISH").getValue(Integer.class) : 0;
                int sCount = snapshot.child("SUNNY").exists() ? snapshot.child("SUNNY").getValue(Integer.class) : 0;
                int aCount = snapshot.child("ALLROUNDER99").exists() ? snapshot.child("ALLROUNDER99").getValue(Integer.class) : 0;

                tvStatsKrish.setText("Krish: " + kCount);
                tvStatsSunny.setText("Sunny: " + sCount);
                tvStatsAllrounder.setText("Allrounder: " + aCount);
            }
            @Override
            public void onCancelled(@NonNull DatabaseError error) {}
        });
    }

    private void clearFields() {
        etPhoneNumber.setText("");
        etMessage.setText("");
        spinnerTeamMember.setSelection(0);
    }
}
